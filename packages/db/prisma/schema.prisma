// SPEC §9 tables, added by the milestone that first uses them.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model PaypalEvent {
  eventId     String   @id @map("event_id")
  type        String
  payloadJson Json     @map("payload_json")
  receivedAt  DateTime @default(now()) @map("received_at")

  @@map("paypal_events")
}

// ── M3 passkeys ─────────────────────────────────────────────────────────────

model User {
  id          String   @id
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  passkeys   RegistryPasskey[]
  approvals  Approval[]
  challenges RegistrationChallenge[]
  mandates   Mandate[]
  logins     LoginChallenge[]
  sessions   Session[]

  @@map("users")
}

/// Trust registry (D5). `signCount` is the merchant gate's last-seen count;
/// the wallet keeps its own in wallet_credentials (D16).
model RegistryPasskey {
  credentialId String   @id @map("credential_id")
  userId       String   @map("user_id")
  /// COSE public key, base64url.
  publicKey    String   @map("public_key")
  signCount    BigInt   @default(0) @map("sign_count")
  transports   String[]
  createdAt    DateTime @default(now()) @map("created_at")

  user   User              @relation(fields: [userId], references: [id])
  wallet WalletCredential?

  @@index([userId])
  @@map("registry_passkeys")
}

/// Consumer service's own last-seen sign count per credential (D16).
model WalletCredential {
  credentialId String @id @map("credential_id")
  signCount    BigInt @default(0) @map("sign_count")

  passkey RegistryPasskey @relation(fields: [credentialId], references: [credentialId])

  @@map("wallet_credentials")
}

/// Pending passkey registration; deleted on first use.
model RegistrationChallenge {
  userId    String   @id @map("user_id")
  challenge String
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id])

  @@map("registration_challenges")
}

/// A cart the human must approve with a passkey. challenge = hash(payloadJson).
model Approval {
  id            String    @id
  userId        String    @map("user_id")
  payloadJson   Json      @map("payload_json")
  /// Unique: one assertion can never approve two approvals (same cart and nonce).
  hash          String    @unique
  status        String    @default("pending") // pending | approved | cancelled
  /// The delivery address the user gave (wallet-side); shown only if hash(shipTo) == cart.shipToHash.
  shipToJson    Json?     @map("ship_to_json")
  /// The signed offer the cart is for (M10 attack demo: "Replayed approval" resends a used one).
  offerJson     Json?     @map("offer_json")
  /// Set once the gate accepted the request carrying this approval (its offer is then used, D28).
  submittedRequestId String? @map("submitted_request_id")
  expiresAt     DateTime  @map("expires_at")
  credentialId  String?   @map("credential_id")
  assertionJson Json?     @map("assertion_json")
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("approvals")
}

// ── M4 mandates ─────────────────────────────────────────────────────────────

/// Intent mandate (SPEC §4.2). challenge = hash(payloadJson); active once the passkey approves it.
model Mandate {
  id            String    @id
  userId        String    @map("user_id")
  payloadJson   Json      @map("payload_json")
  hash          String    @unique
  status        String    @default("pending") // pending | active
  /// A pending mandate must be approved before this; after it, it can never activate.
  pendingUntil  DateTime  @map("pending_until")
  credentialId  String?   @map("credential_id")
  assertionJson Json?     @map("assertion_json")
  activatedAt   DateTime? @map("activated_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user  User           @relation(fields: [userId], references: [id])
  spend MandateSpend[]

  @@index([userId])
  @@map("mandates")
}

/// Period ledger (D17): one row per mandate per UTC calendar bucket. Written only by the merchant
/// gate: reserve at authorize, release on void.
model MandateSpend {
  mandateId   String   @map("mandate_id")
  periodStart DateTime @map("period_start")
  spentMinor  BigInt   @default(0) @map("spent_minor")

  mandate Mandate @relation(fields: [mandateId], references: [id])

  @@id([mandateId, periodStart])
  @@map("mandate_spend")
}

// ── M5 registry + merchant ──────────────────────────────────────────────────

/// Trust registry (SPEC §2, pitched as PayPal-operated): merchant ↔ PayPal merchant id.
model RegistryMerchant {
  id               String @id
  name             String
  paypalMerchantId String @unique @map("paypal_merchant_id")
  status           String @default("active") // active | suspended

  agents RegistryAgent[]

  @@map("registry_merchants")
}

/// Trust registry: agent public keys. A merchant agent belongs to exactly one merchant.
model RegistryAgent {
  id         String  @id
  role       String // merchant | consumer
  /// Ed25519 SPKI DER, base64url.
  publicKey  String  @map("public_key")
  status     String  @default("active") // active | suspended
  merchantId String? @map("merchant_id")

  merchant RegistryMerchant? @relation(fields: [merchantId], references: [id])
  offers   Offer[]

  @@map("registry_agents")
}

/// Catalog. Prices come only from here, never from a request or an LLM (rule 2).
model Product {
  sku        String @id
  name       String
  category   String
  priceMinor Int    @map("price_minor")
  stock      Int

  holds StockHold[]

  @@map("products")
}

/// A signed offer (SPEC §4.1). open → used (gate, M7) | expired (hold job); each by compare-and-set.
model Offer {
  id          String   @id
  /// The consumer agent that asked for it; caps open offers per agent.
  agentId     String   @map("agent_id")
  payloadJson Json     @map("payload_json")
  hash        String   @unique
  status      String   @default("open") // open | used | expired
  holdUntil   DateTime @map("hold_until")
  createdAt   DateTime @default(now()) @map("created_at")

  agent RegistryAgent @relation(fields: [agentId], references: [id])
  holds StockHold[]

  @@index([agentId, status])
  @@index([status, holdUntil])
  @@map("offers")
}

model StockHold {
  offerId String @map("offer_id")
  sku     String
  qty     Int

  offer   Offer   @relation(fields: [offerId], references: [id])
  product Product @relation(fields: [sku], references: [sku])

  @@id([offerId, sku])
  @@map("stock_holds")
}

/// Signed-payload nonces seen by this service, per signer and payload type (D22), so one agent
/// can't burn another's nonce. Rows past `exp` can be deleted.
model UsedNonce {
  kid   String
  type  String
  nonce String
  exp   DateTime

  @@id([kid, type, nonce])
  @@index([exp])
  @@map("used_nonces")
}

// ── M6 wallet login ─────────────────────────────────────────────────────────

/// Pending passkey login: challenge = hash(payloadJson); deleted on first use.
model LoginChallenge {
  id          String   @id
  userId      String   @map("user_id")
  payloadJson Json     @map("payload_json")
  expiresAt   DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id])

  @@map("login_challenges")
}

/// Wallet session after a UV passkey login. Only the SHA-256 of the bearer token is stored.
model Session {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

// ── M7 gate + settlement ────────────────────────────────────────────────────

/// One per payment requestId (SPEC §6 step 2). The receipt is returned again on a duplicate.
model PaymentRequestRow {
  requestId   String   @id @map("request_id")
  agentId     String   @map("agent_id")
  userId      String   @map("user_id")
  offerId     String   @unique @map("offer_id")
  receiptJson Json?    @map("receipt_json")
  createdAt   DateTime @default(now()) @map("created_at")

  order Order?

  @@map("payment_requests")
}

/// Orders (SPEC §7.1). Status changes only through the state machine (`transition`).
model Order {
  id              String    @id
  requestId       String    @unique @map("request_id")
  userId          String    @map("user_id")
  offerId         String    @unique @map("offer_id")
  status          String // OrderStatus
  path            String // passkey | mandate
  totalMinor      Int       @map("total_minor")
  currency        String
  offerHash       String    @map("offer_hash")
  approvalHash    String    @map("approval_hash")
  mandateId       String?   @map("mandate_id")
  /// The ledger bucket reserved at the gate; released on void/failure (D17).
  periodStart     DateTime? @map("period_start")
  paypalOrderId   String?   @unique @map("paypal_order_id")
  authorizationId String?   @unique @map("authorization_id")
  captureId       String?   @unique @map("capture_id")
  refundId        String?   @map("refund_id")
  refundedMinor   Int       @default(0) @map("refunded_minor")
  /// PayPal approve link while the buyer still has to approve a first (vault-saving) order.
  payerActionUrl  String?   @map("payer_action_url")
  trackingNumber  String?   @map("tracking_number")
  /// The order's own wallet user came back from PayPal in their signed-in browser (D23, D29): a vault
  /// saved for this order afterwards is stored pending instead of unbound.
  ownerReturnedAt DateTime? @map("owner_returned_at")
  /// Fulfil (capture) or void by this time; the expiry job voids after it.
  fulfilBy        DateTime  @map("fulfil_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  request PaymentRequestRow @relation(fields: [requestId], references: [requestId])

  @@index([status, fulfilBy])
  @@index([userId, createdAt])
  @@map("orders")
}

/// Every gate step's outcome (SPEC §6), streamed to the dashboard in M8.
model Decision {
  id        Int      @id @default(autoincrement())
  requestId String   @map("request_id")
  step      String
  result    String // pass | fail | step_up | skip
  reason    String
  at        DateTime @default(now())

  @@index([requestId])
  @@map("decisions")
}

/// Saved PayPal wallet per wallet user (D7, D22). Server-side only; never logged or returned.
model PaypalVault {
  userId      String    @id @map("user_id")
  vaultId     String    @map("vault_id")
  customerId  String?   @map("customer_id")
  /// The PayPal account that approved saving it. A confirmed vault is never replaced by another payer.
  payerId     String?   @map("payer_id")
  payerEmail  String?   @map("payer_email")
  /// The order whose authorize saved it; only that order's owner return can bind it (D31).
  orderId     String?   @map("order_id")
  /// pending until the wallet user confirms the payer with a passkey (M8); only confirmed vaults pay.
  status      String    @default("pending")
  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("paypal_vaults")
}

/// Webhook events that didn't fit the order state machine (D15), for a human to look at.
model Reconciliation {
  id        Int      @id @default(autoincrement())
  eventId   String   @map("event_id")
  eventType String   @map("event_type")
  orderId   String?  @map("order_id")
  fromState String?  @map("from_state")
  toState   String?  @map("to_state")
  note      String
  at        DateTime @default(now())

  @@map("reconciliations")
}
