# Copy to .env (never commit .env)
NODE_ENV=development
DEMO_MODE=true

# Neon Postgres (neon.tech, free tier). Use the "dev" branch locally, "main" in production.
# DATABASE_URL = pooled connection string (host contains -pooler); DIRECT_URL = direct one, used by Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/handshake?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/handshake?sslmode=require

# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=

# LLM (OpenAI-compatible; e.g. Groq)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Handshake
WEBAUTHN_ORIGIN=http://localhost:3000

# Agent keys (Ed25519, base64url PKCS8 / SPKI) — generate with `pnpm keys:gen`
MERCHANT_AGENT_ID=agt_m_demo
MERCHANT_AGENT_PRIVATE_KEY=
CONSUMER_AGENT_ID=agt_c_demo
CONSUMER_AGENT_PRIVATE_KEY=

MERCHANT_URL=http://localhost:4001
CONSUMER_URL=http://localhost:4002
WEB_URL=http://localhost:3000
